{%- macro etapes(liste) -%}
  {%- for e in liste %}
  <section class="visite-etape apparition">
    <div class="visite-texte">
      <span class="numero">{{ "0" if loop.index < 10 }}{{ loop.index }}</span>
      <h3>{{ e.titre }}</h3>
      <p>{{ e.texte }}</p>
    </div>
    <div class="visite-images">
      {%- for img in e.images %}
      <figure class="visite-{{ img[1] }}">
        <a href="/assets/img/tbird/visite/{{ img[0] }}.jpg" target="_blank" rel="noopener">
          <img src="/assets/img/tbird/visite/{{ img[0] }}.jpg" alt="{{ img[2] }}" loading="lazy"
               width="{{ 1440 if img[1] == 'ordi' else 780 }}" height="{{ 900 if img[1] == 'ordi' else 1688 }}">
        </a>
        <figcaption>{{ img[2] }}</figcaption>
      </figure>
      {%- endfor %}
    </div>
  </section>
  {%- endfor %}
{%- endmacro -%}

<header class="bandeau">
  <div class="conteneur">
    <p class="surtitre"><a href="/realisations/">Réalisations</a> · <a href="/realisations/tbird-paris/">T-Bird Paris</a> · Visite guidée</p>
    <h1>T-Bird Paris en images</h1>
    <p class="chapeau">Ce que voit un client sur <a href="https://tbird68.fr" rel="noopener">tbird68.fr</a>, puis l’espace réservé à la boutique. Captures du 30 septembre 2026.</p>
    <div class="actions">
      <a class="bouton" href="#cote-client">Côté client</a>
      <a class="bouton bouton-secondaire" href="#cote-boutique">Côté boutique</a>
    </div>
  </div>
</header>

<section class="conteneur section" id="cote-client">
  <p class="surtitre">Côté client</p>
  <h2>La boutique en ligne</h2>
  <p class="chapeau">Captures du site en ligne, tel que le voit n’importe quel visiteur.</p>
  {{ etapes(client) }}
</section>

<section class="section section-teintee" id="cote-boutique">
  <div class="conteneur">
    <p class="surtitre">Côté boutique</p>
    <h2>L’espace des propriétaires</h2>
    <p class="chapeau">Captures faites sur une copie de développement du site, avec des données de test. <strong>Les noms, adresses, emails, téléphones et montants des commandes sont masqués</strong>, tout comme les clés des services (paiement, envois).</p>
    {{ etapes(boutique) }}
  </div>
</section>

