{%- set liens = [
  ["/realisations/", "Réalisations"],
  ["/parcours/", "Parcours"],
  ["/competences/", "Compétences"],
  ["/objectifs/", "Objectifs"],
  ["/veille/", "Veille"],
  ["/journal/", "Journal"],
  ["/contact/", "Contact"]
] -%}
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.nom }}</title>
  <meta name="description" content="{{ resume or site.accroche }}">
  <meta name="theme-color" content="#f5f6f8">
  <link rel="preload" href="/assets/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='3' y='3' width='26' height='26' rx='8' fill='%23ffe34a' stroke='%23fff' stroke-width='3' transform='rotate(-6 16 16)'/%3E%3Ctext x='16' y='21' text-anchor='middle' font-family='Arial' font-weight='700' font-size='13' fill='%231e2127'%3EMC%3C/text%3E%3C/svg%3E">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <a class="evitement" href="#contenu">Aller au contenu</a>

  <header class="entete">
    <div class="conteneur entete-ligne">
      <a class="marque" href="/">{{ site.nom }}</a>
      <nav id="menu" class="menu" aria-label="Navigation principale">
        {%- for lien in liens %}
        <a href="{{ lien[0] }}"{% if page.url.startsWith(lien[0]) %} aria-current="page"{% endif %}>{{ lien[1] }}</a>
        {%- endfor %}
      </nav>
      <button class="menu-bouton" type="button" aria-expanded="false" aria-controls="menu">
        <span class="menu-icone" aria-hidden="true"></span><span class="visuellement-cache">Menu</span>
      </button>
    </div>
  </header>

  <main id="contenu">
    {{ content | safe }}
  </main>

  <footer class="pied">
    <div class="conteneur pied-ligne">
      <p>{{ site.nom }}. {{ site.titre }}.</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a>{% if site.depot %}<span class="pied-sep"></span><a href="{{ site.depot }}" rel="noopener">Code source du site</a>{% endif %}</p>
    </div>
  </footer>

  <script src="/assets/site.js" defer></script>
</body>
</html>
