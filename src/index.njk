---
layout: base.njk
---
{%- set vedette = collections.realisations | filtrerPar("vedette", true) | first %}
{%- set derniere = collections.journal[0] %}
<section class="accueil">
  <div class="conteneur accueil-grille">
    <div class="accueil-texte">
      <h1 class="accueil-nom">{{ site.nom | replace(" ", "<br>") | safe }}</h1>
      <p class="accueil-titre">{{ site.titre }}.</p>
      <p class="accueil-intro">Je suis venu à l’informatique par le jeu vidéo, après un premier parcours dans l’éducation. Ici, mes réalisations, ce que j’apprends et ce que je vise.</p>
      <div class="actions">
        <a class="bouton" href="/realisations/">Voir mes réalisations</a>
        <a class="bouton bouton-secondaire" href="/contact/">Me contacter</a>
      </div>
    </div>

    {#- La planche de stickers : la photo détourée et ce qui m'occupe. #}
    <div class="planche" aria-label="Photo et centres d’intérêt">
      <img class="planche-photo" src="/assets/img/photo.png" alt="Photo de {{ site.nom }}" width="112" height="112">
      <ul class="planche-stickers">
        <li class="sticker sticker-bic">Systèmes et réseaux</li>
        {%- for i in competences.interets %}<li class="sticker sticker-{{ i.couleur }}">{{ i.titre }}</li>{% endfor %}
      </ul>
      <p class="note note-planche" aria-hidden="true">pas de fond noir ni de code vert qui défile ici. c’était la version 1</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="conteneur">
    <div class="titre-ligne">
      <h2>Ce que j’ai construit</h2>
      <a class="lien-discret" href="/realisations/">Toutes les réalisations</a>
    </div>

    {%- if vedette %}
    <article class="vedette">
      <a class="vedette-image" href="{{ vedette.url }}" tabindex="-1" aria-hidden="true">
        <img src="{{ vedette.data.image }}" alt="" width="1440" height="900" loading="lazy">
      </a>
      <div class="vedette-texte">
        <p class="vedette-cadre">{{ vedette.data.periode }}</p>
        <h3><a href="{{ vedette.url }}">{{ vedette.data.title }}</a></h3>
        <p>{{ vedette.data.resume }}</p>
        <dl class="vedette-faits">
          {%- if vedette.data.statut %}<div><dt>Statut</dt><dd>{{ vedette.data.statut }}</dd></div>{% endif %}
          {%- if vedette.data.aide %}<div><dt>Avec quoi</dt><dd>{{ vedette.data.aide }}</dd></div>{% endif %}
        </dl>
        <div class="actions">
          <a class="bouton" href="{{ vedette.url }}">Lire la fiche</a>
          {%- for l in vedette.data.liens %}{% if loop.first %}<a class="bouton bouton-secondaire" href="{{ l.url }}">{{ l.titre }}</a>{% endif %}{% endfor %}
        </div>
      </div>
    </article>
    {%- endif %}

    <ul class="autres-realisations">
      {%- for item in collections.realisations %}{% if not item.data.vedette %}
      <li>
        <h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
        <p>{{ item.data.resume }}</p>
        <p class="autres-meta">{{ item.data.periode }}</p>
      </li>
      {%- endif %}{% endfor %}
    </ul>
    <p class="note note-realisations" aria-hidden="true">chaque fiche dit ce qui vient de moi, et ce qui vient d’un guide ou d’une IA</p>
  </div>
</section>

<section class="section section-teintee">
  <div class="conteneur deux-colonnes deux-colonnes-egales">
    <div>
      <div class="titre-ligne">
        <h2>D’où je viens</h2>
        <a class="lien-discret" href="/parcours/">Tout le parcours</a>
      </div>
      <ol class="frise">
        {%- for e in parcours.formation.slice(0, 3) %}
        <li>
          <span class="frise-periode">{{ e.periode }}</span>
          <h3>{{ e.titre }}</h3>
          <p class="frise-lieu">{{ e.lieu }}</p>
        </li>
        {%- endfor %}
      </ol>
    </div>
    <div>
      <div class="titre-ligne">
        <h2>Où je vais</h2>
        <a class="lien-discret" href="/objectifs/">Ma feuille de route</a>
      </div>
      <ul class="objectifs objectifs-compacts">
        {%- for etape in objectifs.etapes %}
          {%- for o in etape.objectifs %}
            {%- if o.statut == "en-cours" or o.statut == "prevu" %}
            <li class="objectif objectif-{{ o.statut }}">
              <span class="pastille-statut">{{ objectifs.legende[o.statut] }}</span>
              <h3>{{ o.titre }}</h3>
            </li>
            {%- endif %}
          {%- endfor %}
        {%- endfor %}
      </ul>
      {%- if derniere %}
      <p class="derniere-note">Dernière note du journal : <a href="{{ derniere.url }}">{{ derniere.data.title }}</a>, le {{ derniere.date | dateLongue }}.</p>
      {%- endif %}
    </div>
  </div>
</section>

<section class="section">
  <div class="conteneur a-cote">
    <h2>À côté de l’informatique</h2>
    <ul class="a-cote-liste">
      {%- for i in competences.interets %}
      <li>
        <span class="sticker sticker-{{ i.couleur }}">{{ i.titre }}</span>
        {%- if i.texte %}<p>{{ i.texte }}</p>{% endif %}
      </li>
      {%- endfor %}
    </ul>
    <p class="note note-a-cote" aria-hidden="true">touche-à-tout, oui. c’est un peu le sujet</p>
  </div>
</section>

<section class="section contact-bloc">
  <div class="conteneur">
    <h2>Une question sur un projet, ou envie d’échanger ?</h2>
    <p><a class="contact-email" href="mailto:{{ site.email }}">{{ site.email }}</a></p>
  </div>
</section>
