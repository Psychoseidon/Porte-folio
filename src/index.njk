---
layout: base.njk
---
{%- set vedette = collections.realisations | filtrerPar("vedette", true) | first %}
{%- set derniere = collections.journal[0] %}
<section class="accueil">
  <div class="conteneur accueil-grille">
    <div class="accueil-texte">
      <h1 class="accueil-nom">{{ site.nom | replace(" ", "<br>") | safe }}</h1>
      <p class="accueil-titre">{{ site.titre }}.</p>
      <p class="accueil-intro">Technicien support et systèmes en formation à l’UTEC de Melun, après un premier métier dans l’enseignement. Je cherche une équipe où toucher au support, aux systèmes et au réseau.</p>
      <div class="actions">
        <a class="bouton" href="/contact/">Me contacter</a>
        <a class="bouton bouton-secondaire" href="/realisations/tbird-paris/">Voir mon projet principal</a>
      </div>
    </div>

    <div class="profil">
      <img class="profil-photo" src="/assets/img/photo.jpg" alt="Photo de {{ site.nom }}" width="494" height="622">
      <dl class="profil-faits">
        <div><dt>Recherche</dt><dd>Alternance, 1 semaine sur 2</dd></div>
        <div><dt>Disponibilité</dt><dd>Immédiate</dd></div>
        <div><dt>Secteur</dt><dd>Melun, Sénart, Évry, ligne du RER D</dd></div>
        <div><dt>École</dt><dd>{{ site.ecole }}</dd></div>
        <div><dt>Mobilité</dt><dd>{{ site.permis }}</dd></div>
      </dl>
    </div>
  </div>
</section>

<section class="section">
  <div class="conteneur">
    <div class="titre-ligne">
      <h2>Mon projet principal</h2>
      <a class="lien-discret" href="/realisations/">Toutes les réalisations</a>
    </div>

    {%- if vedette %}
    <article class="vedette">
      <a class="vedette-image" href="{{ vedette.url }}" tabindex="-1" aria-hidden="true">
        <img src="{{ vedette.data.image }}" alt="" width="1440" height="900" loading="lazy">
      </a>
      <div class="vedette-texte">
        <p class="vedette-cadre">{{ vedette.data.periode }}</p>
        <h3><a href="{{ vedette.url }}">{{ vedette.data.title }}</a></h3>
        <p>{{ vedette.data.resume }}</p>
        <dl class="vedette-faits">
          {%- if vedette.data.statut %}<div><dt>Statut</dt><dd>{{ vedette.data.statut }}</dd></div>{% endif %}
          {%- if vedette.data.aide %}<div><dt>Avec quoi</dt><dd>{{ vedette.data.aide }}</dd></div>{% endif %}
        </dl>
        <div class="actions">
          <a class="bouton" href="{{ vedette.url }}">Lire la fiche</a>
          {%- for l in vedette.data.liens %}{% if loop.first %}<a class="bouton bouton-secondaire" href="{{ l.url }}">{{ l.titre }}</a>{% endif %}{% endfor %}
        </div>
      </div>
    </article>
    {%- endif %}

    <ul class="autres-realisations">
      {%- for item in collections.realisations %}{% if not item.data.vedette %}
      <li>
        <h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
        <p>{{ item.data.resume }}</p>
        <p class="autres-meta">{{ item.data.periode }}</p>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</section>

<section class="section section-teintee">
  <div class="conteneur deux-colonnes deux-colonnes-egales">
    <div>
      <div class="titre-ligne">
        <h2>Expérience</h2>
        <a class="lien-discret" href="/parcours/">Tout le parcours</a>
      </div>
      <ol class="frise">
        {%- for e in parcours.experience %}
        <li>
          <span class="frise-periode">{{ e.periode }}</span>
          <h3>{{ e.titre }}</h3>
          <p class="frise-lieu">{{ e.lieu }}</p>
        </li>
        {%- endfor %}
      </ol>
    </div>
    <div>
      <div class="titre-ligne">
        <h2>Compétences</h2>
        <a class="lien-discret" href="/competences/">Le détail</a>
      </div>
      <ul class="accueil-competences">
        {%- for t in competences.techniques.slice(0, 5) %}
        <li><h3>{{ t.titre }}</h3><p>{{ t.points | join(" · ") }}</p></li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="section">
  <div class="conteneur creation-site">
    <h2>Besoin d’un site pour votre activité ?</h2>
    <p>Je crée aussi des sites pour les commerces et les indépendants : conception avec un agent IA de développement, mise en ligne sur un serveur que j’administre, puis suivi dans le temps. Vous échangez avec une seule personne, qui vous explique les choses simplement.</p>
    <p>Mon premier client, <a href="/realisations/tbird-paris/">la boutique parisienne T-Bird</a>, vend en ligne depuis septembre 2026 : catalogue, paiement, livraison, et une administration pensée pour ses propriétaires.</p>
    <div class="actions">
      <a class="bouton" href="/contact/">Parler de votre projet</a>
      <a class="bouton bouton-secondaire" href="https://tbird68.fr" rel="noopener">Voir le site en ligne</a>
    </div>
  </div>
</section>

<section class="section contact-bloc">
  <div class="conteneur">
    <h2>Vous cherchez un alternant en systèmes et réseaux ?</h2>
    <p><a class="contact-email" href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    <p><a href="{{ site.linkedin }}" rel="noopener">Mon profil LinkedIn</a></p>
  </div>
</section>
